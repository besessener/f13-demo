# =============================================================================
# f13-demo – Variablen für docker-compose.yml
# =============================================================================
# Docker Compose liest diese Datei automatisch (sie liegt neben docker-compose.yml).
# Sie enthält KEINE Geheimnisse und wird bewusst mit eingecheckt.
#
# Werte ändern, dann neu starten:
#   docker compose up -d
#
# Wichtig bei einem Modellwechsel: Die YAML-Konfigurationen der F13-Dienste können
# diese Datei NICHT lesen. Wer LLM_MODELL oder EMBEDDING_MODELL ändert, muss den
# Modellnamen zusätzlich von Hand eintragen in:
#   - config/f13/llm_models.yml   (summary, rag, Embedding)
#   - config/chat/llm_models.yml  (chat)
# Danach: docker compose run --rm modelle-laden  und  docker compose up -d --force-recreate
# =============================================================================

# --- Ports auf dem Rechner (nur 127.0.0.1, also nicht im Büronetz sichtbar) ---
FRONTEND_PORT=9999
CORE_PORT=8000

# --- Versionen (alle Images sind hierüber gepinnt) ---
# Aktuelle Tags der F13-Images zeigt:  docker compose run --rm versionen
# Frontend: Git-Tag, aus dem das Image lokal gebaut wird (es gibt kein fertiges Image).
F13_FRONTEND_VERSION=v3.0.1
F13_CHAT_VERSION=v3.0.0
F13_FEEDBACK_VERSION=v1.0.1
# Tags für summary, rag und parser in der CI per "versionen" bestätigt (20.10.2026).
F13_SUMMARY_VERSION=v4.1.0
F13_RAG_VERSION=v3.1.1
F13_PARSER_VERSION=v2.1.5
OLLAMA_VERSION=0.40.6
APISIX_VERSION=3.15.0-ubuntu
OPA_VERSION=1.18.1-debug
ELASTICSEARCH_VERSION=8.19.23
POSTGRES_VERSION=18-alpine
WERKZEUG_PYTHON_VERSION=3.15-alpine

# --- Modelle (Ollama-Tags) ---
LLM_MODELL=llama3.2:3b
EMBEDDING_MODELL=granite-embedding:278m
